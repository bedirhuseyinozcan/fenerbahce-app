{
  "expo": {
    "name": "Fenerbahçe 1907",
    "slug": "fenerbahce-app",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fenerbahceapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#072146"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fbbedir.fenerbahce1907",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#072146"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#072146"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "946675c7-3e15-43f2-8b3f-85cbb99e6f3c"
      }
    },
    "owner": "hsifuzuli",
    "updates": {
      "url": "https://u.expo.dev/946675c7-3e15-43f2-8b3f-85cbb99e6f3c"
    }
  }
}
