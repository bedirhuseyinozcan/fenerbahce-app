{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fenerbahce-match-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fenerbahce-db",
      "database_id": "d0342e51-141b-4ed5-baf3-2a39673dfcab"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_WATCHER",
        "class_name": "MatchWatcher"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchWatcher"]
    }
  ],
  "triggers": {
    "crons": ["*/1 * * * *"]
  }
}
